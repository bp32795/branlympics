{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_next/*", "/images/*", "/*.{png,jpg,jpeg,gif,svg,ico,webp}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  }
}
